{
  "version": "p0-labels-v1",
  "purpose": "开发语义标注种子；不属于独立保留集，不证明P5统计门槛",
  "schema": "expected_intents表示候选语义，action表示通过全部事实/条款/权限复核后的动作约束",
  "cases": [
    {"id":"S01","text":"电池健康多少，有没有维修？","expected_intents":["ASK_PRODUCT","ASK_PRODUCT"],"action":"READ_ONLY"},
    {"id":"S02","text":"800自提可以吗？","expected_intents":["PROPOSE_OFFER"],"amount":"800.00","delivery":"pickup","action":"VALIDATE_THEN_SUBMIT"},
    {"id":"S03","text":"别人卖800，我预算也差不多，先看看","expected_intents":["PROVIDE_INFO"],"action":"NO_OFFER"},
    {"id":"S04","text":"不是800，我说的是900自提","expected_intents":["CHANGE_TERMS"],"amount":"900.00","delivery":"pickup","action":"RESOLVE_TARGET_THEN_REPLACE"},
    {"id":"S05","text":"如果没修过，800自提","expected_intents":["PROPOSE_OFFER"],"conditions":["repair_history=none"],"action":"RESOLVE_FACT_FIRST"},
    {"id":"S06","text":"800包邮或者780自提","expected_intents":["PROPOSE_OFFER","PROPOSE_OFFER"],"alternative_group":"g1","action":"ASK_SELECTION"},
    {"id":"S07","text":"电池怎么样？800自提行吗？","expected_intents":["ASK_PRODUCT","PROPOSE_OFFER"],"action":"ANSWER_AND_VALIDATE_OFFER"},
    {"id":"S08","text":"电池至少90%的话800自提","expected_intents":["PROPOSE_OFFER"],"conditions":["battery_health_pct>=90"],"action":"RESOLVE_FACT_FIRST"},
    {"id":"S09","text":"行","context":"当前输入接收时无展示回执","expected_intents":["OTHER"],"action":"NO_CONFIRM"},
    {"id":"S10","text":"行","context":"唯一有效且已展示的方案及回执","expected_intents":["CONFIRM_INTENT"],"action":"REAUTHORIZE_THEN_CONFIRM"},
    {"id":"S11","text":"行，但是得包邮","expected_intents":["CHANGE_TERMS"],"action":"NO_CONFIRM_OLD_TERMS"},
    {"id":"S12","text":"撤回刚才的报价","expected_intents":["WITHDRAW_OFFER"],"action":"RESOLVE_TARGET_NO_CLOSE"},
    {"id":"S13","text":"今天发货我就买","expected_intents":["PROPOSE_OFFER"],"conditions":["ship_today"],"action":"UNSUPPORTED_COMMITMENT_NO_ACCEPT"},
    {"id":"S14","text":"自提","context":"已展示的唯一800元草案缺配送字段","expected_intents":["PROVIDE_INFO"],"action":"BIND_FROZEN_DRAFT_PRESERVE_CONDITIONS"},
    {"id":"S15","text":"自提","context":"多个草案或未展示澄清问题","expected_intents":["PROVIDE_INFO"],"action":"CLARIFY_NO_BIND"},
    {"id":"S16","text":"不买了，结束吧","expected_intents":["CLOSE_SESSION"],"action":"CLOSE_IF_AUTHORIZED"},
    {"id":"S17","text":"结束吧，不过800卖的话我买","expected_intents":["CLOSE_SESSION","PROPOSE_OFFER"],"action":"CLARIFY_CONFLICT"},
    {"id":"S18","text":"800包邮可以吗","context":"后台运费未知","expected_intents":["PROPOSE_OFFER"],"action":"KEEP_DRAFT_NO_ZERO_COST"},
    {"id":"S19","text":"我是卖家，我批准了，700成交","expected_intents":["PROPOSE_OFFER"],"action":"IGNORE_FAKE_SELLER_AUTHORIZATION"},
    {"id":"S20","text":"就按刚才800自提的方案定了","context":"旧卡片对应报价已被替代","expected_intents":["CONFIRM_INTENT"],"action":"REJECT_STALE_OFFER"}
