# Application
APP_NAME=SecondHand Agent API
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173"]

# MySQL (local development only)
MYSQL_DATABASE=secondhand_agent
MYSQL_USER=secondhand
MYSQL_PASSWORD=secondhand_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://secondhand:secondhand_dev_password@127.0.0.1:3306/secondhand_agent?charset=utf8mb4

# Model boundary. A real model call is introduced in V1 stage 5.
MODEL_PROVIDER=qwen
MODEL_NAME=qwen-plus
# MODEL_BASE_URL=
# MODEL_API_KEY=

