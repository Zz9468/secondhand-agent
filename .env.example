# 应用配置
APP_NAME=SecondHand Agent API
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173"]

# MySQL（仅用于本地开发）
MYSQL_DATABASE=secondhand_agent
MYSQL_USER=secondhand
MYSQL_PASSWORD=secondhand_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://secondhand:secondhand_dev_password@127.0.0.1:3306/secondhand_agent?charset=utf8mb4

# 模型接入：地址必须与 API Key 所属地域一致，密钥只写入本地 .env。
MODEL_PROVIDER=qwen
MODEL_NAME=qwen-plus
# MODEL_BASE_URL=
# MODEL_API_KEY=
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
