# 应用配置
APP_NAME=SecondHand Agent API
ENVIRONMENT=development
API_PREFIX=/api
GRAPH_CHAT_ENABLED=true
# Compose 强制启用完整就绪检查；源码测试默认 false。
GRAPH_REQUIRE_SERVICES=false
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]

# MySQL（仅用于本地开发；复制后必须替换以下两个 CHANGE_ME 占位值）
COMPOSE_PROJECT_NAME=secondhand-agent-langgraph
MYSQL_DATABASE=secondhand_langgraph
MYSQL_USER=langgraph_app
MYSQL_PASSWORD=CHANGE_ME_TO_A_RANDOM_LOCAL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_RANDOM_LOCAL_PASSWORD
MYSQL_PORT=3307
DATABASE_URL=mysql+pymysql://langgraph_app:CHANGE_ME_TO_A_RANDOM_LOCAL_PASSWORD@127.0.0.1:3307/secondhand_langgraph?charset=utf8mb4
# 完整 Compose 栈在容器网络中使用 mysql 主机名；密码需做 URL 编码。
CONTAINER_DATABASE_URL=mysql+pymysql://langgraph_app:CHANGE_ME_TO_A_RANDOM_LOCAL_PASSWORD@mysql:3306/secondhand_langgraph?charset=utf8mb4
API_PORT=8100
FRONTEND_PORT=5174
POSTGRES_DB=secondhand_checkpoints
POSTGRES_USER=checkpoint_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_AN_INDEPENDENT_ADMIN_PASSWORD
CHECKPOINT_PASSWORD=CHANGE_ME_TO_AN_INDEPENDENT_WORKER_PASSWORD
POSTGRES_PORT=5433
CHECKPOINT_DATABASE_URL=postgresql://checkpoint_worker:CHANGE_ME_TO_AN_INDEPENDENT_WORKER_PASSWORD@127.0.0.1:5433/secondhand_checkpoints
LANGSMITH_PROJECT=secondhand-agent-langgraph-test
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=false
# P4：仅在 GraphRunner 的严格脱敏作用域内开启原生追踪；保持全局开关关闭。
GRAPH_LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# Docker Hub 不可达时可临时切换兼容镜像代理；默认仍使用 docker.io。
# DOCKER_REGISTRY=docker.m.daocloud.io

# 身份认证（必须替换；AUTH_SECRET 至少 32 个字符）
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_COOKIE_SECURE=false
USER_SESSION_MINUTES=480
DEMO_SELLER_PASSWORD=CHANGE_ME_TO_A_STRONG_DEMO_PASSWORD

# 模型接入：地址必须与 API Key 所属地域一致，密钥只写入本地 .env。
MODEL_PROVIDER=qwen
MODEL_NAME=qwen3.7-flash
# MODEL_BASE_URL=
# MODEL_API_KEY=
MODEL_TEMPERATURE=0
MODEL_ENABLE_THINKING=false
MODEL_THINKING_BUDGET=768
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=0
MODEL_TASK_MAX_ATTEMPTS=3
MODEL_TASK_RETRY_BASE_SECONDS=2
MODEL_TASK_RETRY_MAX_SECONDS=300
MODEL_TASK_RETRY_JITTER_RATIO=0.2
MODEL_TASK_LEASE_SECONDS=300

# 模型价格快照（每百万 Token）；不配置时 Token 仍记录，成本保持未知而不是按 0 处理。
# MODEL_INPUT_PRICE_PER_MILLION=
# MODEL_OUTPUT_PRICE_PER_MILLION=
# MODEL_CACHED_INPUT_PRICE_PER_MILLION=
# MODEL_COST_CURRENCY=CNY


# P6 初始化器自动生成 URL；账号相互独立，口令需 URL 编码。
GRAPH_CLEANER_PASSWORD=CHANGE_ME_TO_AN_INDEPENDENT_CLEANER_PASSWORD
CONTAINER_CHECKPOINT_DATABASE_URL=postgresql://checkpoint_worker:CHANGE_ME@checkpoint:5432/secondhand_checkpoints
CHECKPOINT_CLEANER_URL=postgresql://graph_cleaner:CHANGE_ME@127.0.0.1:5433/secondhand_checkpoints
CONTAINER_CHECKPOINT_CLEANER_URL=postgresql://graph_cleaner:CHANGE_ME@checkpoint:5432/secondhand_checkpoints
