# 应用配置
APP_NAME=SecondHand Agent API
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173"]

# MySQL（仅用于本地开发；复制后必须替换以下两个 CHANGE_ME 占位值）
MYSQL_DATABASE=secondhand_agent
MYSQL_USER=secondhand
MYSQL_PASSWORD=CHANGE_ME_TO_A_RANDOM_LOCAL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_RANDOM_LOCAL_PASSWORD
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://secondhand:CHANGE_ME_TO_A_RANDOM_LOCAL_PASSWORD@127.0.0.1:3306/secondhand_agent?charset=utf8mb4
# 完整 Compose 栈在容器网络中使用 mysql 主机名；密码需做 URL 编码。
CONTAINER_DATABASE_URL=mysql+pymysql://secondhand:CHANGE_ME_TO_A_RANDOM_LOCAL_PASSWORD@mysql:3306/secondhand_agent?charset=utf8mb4
API_PORT=8000
FRONTEND_PORT=5173
# Docker Hub 不可达时可临时切换兼容镜像代理；默认仍使用 docker.io。
# DOCKER_REGISTRY=docker.m.daocloud.io

# 身份认证（必须替换；AUTH_SECRET 至少 32 个字符）
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_COOKIE_SECURE=false
USER_SESSION_MINUTES=480
DEMO_SELLER_PASSWORD=CHANGE_ME_TO_A_STRONG_DEMO_PASSWORD

# 模型接入：地址必须与 API Key 所属地域一致，密钥只写入本地 .env。
MODEL_PROVIDER=qwen
MODEL_NAME=qwen-plus
# MODEL_BASE_URL=
# MODEL_API_KEY=
MODEL_TEMPERATURE=0
MODEL_ENABLE_THINKING=false
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_TASK_MAX_ATTEMPTS=3
MODEL_TASK_RETRY_BASE_SECONDS=2
MODEL_TASK_RETRY_MAX_SECONDS=300
MODEL_TASK_RETRY_JITTER_RATIO=0.2
MODEL_TASK_LEASE_SECONDS=300

# 模型价格快照（每百万 Token）；不配置时 Token 仍记录，成本保持未知而不是按 0 处理。
# MODEL_INPUT_PRICE_PER_MILLION=
# MODEL_OUTPUT_PRICE_PER_MILLION=
# MODEL_CACHED_INPUT_PRICE_PER_MILLION=
# MODEL_COST_CURRENCY=CNY

# 可选 LangSmith 脱敏 Trace。不要设置 LANGSMITH_TRACING=true，避免自动上传原始提示词。
OBSERVABILITY_LANGSMITH_ENABLED=false
# OBSERVABILITY_LANGSMITH_API_KEY=
OBSERVABILITY_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
OBSERVABILITY_LANGSMITH_PROJECT=secondhand-agent
OBSERVABILITY_LANGSMITH_TIMEOUT_SECONDS=2
